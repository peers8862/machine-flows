# Example only. The real file is ~/.config/mach/secrets.toml: it is NOT inside machine-flows, never synced, never committed.
# Create it with `chmod 600 ~/.config/mach/secrets.toml`; mach refuses a file that is readable by others.
# Every value below is a placeholder.

[grokbot_router]
url = "https://router.example.invalid/hook"
key = "replace-with-your-sender-key"
key_header = "Authorization: Bearer"   # or "X-Webhook-Key" to send X-Webhook-Key: <key>
